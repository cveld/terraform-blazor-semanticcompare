@inherits LayoutComponentBase
@using System.Reflection

<div class="page">
    <main>
        <article class="content px-4">
            @Body
        </article>
        <footer class="app-footer px-4">
            Version @Version &middot; built on @BuildDate (UTC)
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly Assembly Asm = typeof(MainLayout).Assembly;

    private static string Version =>
        (Asm.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown").Split('+')[0];

    private static string BuildDate =>
        Asm.GetCustomAttributes<AssemblyMetadataAttribute>().FirstOrDefault(a => a.Key == "BuildDate")?.Value ?? "unknown";
}

