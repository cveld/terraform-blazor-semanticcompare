<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorSemanticCompare.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script>
        window._clipboardText = null;
        window.prepareClipboardChunking = async function (chunkSize, maxLength) {
            try {
                const text = await navigator.clipboard.readText();
                if (text.length > maxLength) {
                    window._clipboardText = null;
                    return { error: `Clipboard content too large (${text.length} chars)` };
                }
                window._clipboardText = text;
                return { totalLength: text.length, chunkCount: Math.ceil(text.length / chunkSize) };
            } catch (e) {
                window._clipboardText = null;
                return { error: e.toString() };
            }
        };
        window.getClipboardChunk = function (chunkSize, chunkIndex) {
            if (!window._clipboardText) return { error: 'Clipboard not prepared' };
            const start = chunkIndex * chunkSize;
            const end = start + chunkSize;
            return { chunk: window._clipboardText.substring(start, end) };
        };
        window.registerWebMcpTools = function (dotNetRef) {
            if (!navigator.modelContext || !navigator.modelContext.registerTool) return;
            try {
                navigator.modelContext.registerTool({
                    name: 'load-terraform-plan',
                    description: 'Loads a terraform plan in JSON format (output of "terraform show -json") into the semantic compare viewer.',
                    inputSchema: {
                        type: 'object',
                        properties: {
                            plan: { type: 'string', description: 'The terraform plan JSON content as a string.' },
                            url: { type: 'string', description: 'URL to fetch the terraform plan JSON from (must allow CORS). Used when plan is not provided.' }
                        }
                    },
                    execute: async (args) => {
                        let plan = args.plan;
                        if (plan === undefined || plan === null || plan === '') {
                            if (!args.url) {
                                return { content: [{ type: 'text', text: 'Error: provide either "plan" or "url".' }], isError: true };
                            }
                            try {
                                const response = await fetch(args.url);
                                if (!response.ok) {
                                    return { content: [{ type: 'text', text: `Error: fetching url failed with HTTP ${response.status}.` }], isError: true };
                                }
                                plan = await response.text();
                            } catch (e) {
                                return { content: [{ type: 'text', text: `Error: fetching url failed: ${e}` }], isError: true };
                            }
                        } else if (typeof plan !== 'string') {
                            plan = JSON.stringify(plan);
                        }
                        const result = await dotNetRef.invokeMethodAsync('LoadTerraformPlanFromTool', plan);
                        return { content: [{ type: 'text', text: result }] };
                    }
                });
            } catch (e) {
                console.warn('WebMCP registration failed', e);
            }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
