            </NavLink>
        </div> *@

        @if (Configuration["DEBUG"]?.Equals("TRUE", StringComparison.OrdinalIgnoreCase) == true)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="debug-semantic-compare">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Debug Semantic Compare
                </NavLink>
            </div>
        }
